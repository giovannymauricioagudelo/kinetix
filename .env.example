# Copiar a .env y completar (no commitear .env)

# SQL Server (Sentinel, Nexus, Matrix, Aurora, Vector, Prism, Orbit e Insight)
SQLSERVER_HOST=localhost
SQLSERVER_DATABASE=kinetix
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server

# Sentinel (SecurityAgent)
SENTINEL_SECRET_KEY=
# sqlserver (por defecto) | memory (solo desarrollo, se pierde al reiniciar)
SENTINEL_REPOSITORY=sqlserver
SENTINEL_ACCESS_MINUTES=15
SENTINEL_REFRESH_DAYS=7
SENTINEL_MAX_FAILED_ATTEMPTS=5
SENTINEL_LOCKOUT_MINUTES=15
SENTINEL_IP_LIMIT_PER_MINUTE=30
# true = los agentes legacy y Cortex exigen token de Sentinel
KINETIX_REQUIRE_AUTH=false

# Nexus (DatabaseAgent)
# sqlserver (por defecto) | memory (catálogo vacío, solo desarrollo)
NEXUS_CATALOG=sqlserver
NEXUS_MAX_ROWS=1000
NEXUS_QUERY_TIMEOUT_SECONDS=30
NEXUS_BACKUP_TIMEOUT_SECONDS=600
# Carpeta del servidor SQL para los .bak; vacío = carpeta de respaldos por defecto de la instancia
NEXUS_BACKUP_DIR=

# Matrix (BusinessRulesAgent)
# sqlserver (por defecto) | memory (solo desarrollo, se pierde al reiniciar)
MATRIX_REPOSITORY=sqlserver

# Argus (MonitoringAgent)
ARGUS_PROBE_INTERVAL_SECONDS=30
ARGUS_SLA_OBJETIVO=99.9
# Token fijo para que un servidor Prometheus raspe /api/v1/argus/metricas
ARGUS_SCRAPE_TOKEN=

# Aurora, Vector, Prism, Orbit e Insight: sqlserver (por defecto, tablas de PLATFORM_AGENTS_SCHEMA.sql) | memory
AURORA_REPOSITORY=sqlserver
VECTOR_REPOSITORY=sqlserver
PRISM_REPOSITORY=sqlserver
ORBIT_REPOSITORY=sqlserver
INSIGHT_REPOSITORY=sqlserver
# Timeout de consultas por agente (AURORA_, VECTOR_, PRISM_, ORBIT_, INSIGHT_)
AURORA_QUERY_TIMEOUT_SECONDS=30

# Repositorio git sobre el que trabajan Vector, Prism y Orbit (vacío = raíz del proyecto)
KINETIX_REPO_PATH=
KINETIX_GIT_TIMEOUT_SECONDS=60

# Prism (QAAgent): cobertura mínima de la compuerta de calidad y tiempo máximo de una ejecución de pytest
PRISM_COBERTURA_MINIMA=80
PRISM_TIMEOUT_SECONDS=900

# Orbit (GitDeploymentAgent)
# Rama en la que debe estar integrado todo commit que se despliega
ORBIT_RELEASE_BRANCH=master
# Workflow de GitHub Actions que se dispara con lanzar_workflow (archivo o id), p. ej. deploy.yml
ORBIT_GITHUB_WORKFLOW=
# Token con permisos actions:write y contents:read; GITHUB_REPOSITORY vacío = se deduce del remoto origin
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_API_URL=https://api.github.com

# Insight (ReportingAgent)
# Cada cuántos segundos se ejecutan las programaciones vencidas (0 = apagado)
INSIGHT_SCHEDULER_INTERVAL_SECONDS=60
INSIGHT_MAX_FILAS=5000
INSIGHT_RETENCION_DIAS=90

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=advance_db
POSTGRES_USER=advance_user
POSTGRES_PASSWORD=
