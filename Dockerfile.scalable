# Multi-stage build para producción escalable

FROM python:3.11-slim as builder

WORKDIR /tmp

# Instalar compiladores necesarios
RUN apt-get update && apt-get install -y \
    build-essential \
    gcc \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copiar requirements
COPY requirements-scalability.txt .

# Compilar wheels
RUN pip wheel --no-cache-dir --no-deps --wheel-dir /tmp/wheels -r requirements-scalability.txt

# ============================================================================
# Production Image
# ============================================================================

FROM python:3.11-slim

WORKDIR /app

# Instalar dependencies en runtime
RUN apt-get update && apt-get install -y \
    curl \
    postgresql-client \
    redis-tools \
    && rm -rf /var/lib/apt/lists/*

# Copiar wheels desde builder
COPY --from=builder /tmp/wheels /wheels
COPY --from=builder /tmp/requirements-scalability.txt .

# Instalar Python packages
RUN pip install --no-cache /wheels/*

# Copiar código de aplicación
COPY src /app/src
COPY main_scalable.py /app/main.py

# Crear usuario no-root
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Expose port
EXPOSE 8000

# Environment variables por defecto
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PG_HOST=localhost \
    PG_PORT=5432 \
    REDIS_HOST=localhost \
    REDIS_PORT=6379 \
    ENVIRONMENT=production

# Comando de inicio con Uvicorn workers
CMD ["uvicorn", "main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "4", \
     "--worker-class", "uvicorn.workers.UvicornWorker", \
     "--log-level", "info", \
     "--access-log", \
     "--use-colors"]
